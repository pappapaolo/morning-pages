# Firebase Configuration
# Copy this file to .env and fill in your Firebase project values
# Get these from: Firebase Console > Project Settings > Your apps > Web app

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Firebase Setup Steps:
# 1. Create Firebase project at https://console.firebase.google.com
# 2. Enable Google Authentication (Authentication > Sign-in method > Google)
# 3. Create Firestore Database (Firestore > Create database)
# 4. Get web app config (Project Settings > Your apps > Add app > Web)
# 5. Fill in the values above
# 6. Add your production domain in Firebase Console > Authentication > Settings > Authorized domains
